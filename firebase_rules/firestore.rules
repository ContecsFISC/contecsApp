rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userRol() {
      return userExists() ? userDoc().data.rol : '';
    }

    function hasRol(roles) {
      return userExists() && userRol() in roles;
    }

    function isStaff() {
      return userExists() && userRol() != 'sin_rol';
    }

    function canGestionarParticipantes() {
      return hasRol([
        'ceo', 'junta_principal', 'junta', 'coordinador',
        'actividades', 'finanzas', 'secretario', 'comunicaciones'
      ]);
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'finanzas'])
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rol == 'sin_rol';
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']))
        || hasRol(['ceo', 'junta_principal'])
      );
    }

    // ── Participantes ─────────────────────────────────────────────────────────
    // Escritura pública: el formulario de registro escribe directamente desde el browser.
    // ── Participantes ────────────────────────────────────────────────────────
    match /participantes/{docId} {
      // Lectura pública: perfil.html consulta por codigo+token sin auth
      allow read: if true;
      // Escritura pública: registro desde el browser sin auth
      allow create: if true;
      allow update: if canGestionarParticipantes();
      allow delete: if hasRol(["ceo","junta_principal"]);
    }

    // Contador secuencial — solo Admin SDK (Cloud Functions)
    match /contadores/{id} {
      allow read, write: if false;
    }

    // ── Inventario y catálogo ────────────────────────────────────────────────
    match /productos/{id} {
      allow read: if isStaff();
      allow create, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
      // Venta Rápida (todos los roles con permiso) solo puede tocar el stock;
      // cambios a otros campos (precio, nombre, etc.) siguen restringidos a gestión.
      allow update: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica'])
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'actualizadoEn']));
    }

    match /categorias/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
    }

    // ── Operaciones financieras ──────────────────────────────────────────────
    match /ventas/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      // Venta Rápida: cualquier rol (excepto sin_rol) puede registrar una venta.
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /compras/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      // Tras registrar la compra, el flujo sube la factura a Storage y luego
      // actualiza solo su estado (factura/facturaEstado/facturaError); quien
      // pudo crear la compra debe poder cerrar ese mismo paso.
      allow update: if hasRol(['ceo', 'junta_principal'])
        || (hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['factura', 'facturaEstado', 'facturaError', 'actualizadoEn']));
      allow delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /mermas/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /fondos/{id} {
      // Ver y editar el fondo libremente: solo gestión financiera.
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas']);
      allow create, delete: if hasRol(['ceo', 'junta_principal', 'finanzas']);
      // Venta Rápida / Compras / Ventas: cualquier staff puede sumar/restar el
      // balance como efecto secundario de una venta o compra (vía increment(),
      // que no requiere leer el documento antes), sin poder ver ni editar
      // libremente el fondo.
      allow update: if hasRol(['ceo', 'junta_principal', 'finanzas'])
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'actualizadoEn']));
    }

    match /fondos_entrada/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas']);
      // Venta Rápida: cualquier rol (excepto sin_rol) genera un movimiento de ingreso.
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /movimientos_inventario/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      // Venta Rápida: cualquier rol (excepto sin_rol) genera el movimiento de salida.
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    // ── Eventos e inscripciones internas ─────────────────────────────────────
    match /eventos/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    match /inscripciones/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // Checkpoints detallados del programa (colección separada)
    match /checkpoints/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // Inscripciones in-situ a talleres por QR (decrementa cupos)
    match /inscripciones_checkpoint/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // ── Voluntarios ──────────────────────────────────────────────────────────
    match /actividades_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /giras_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado', 'giras']);
    }

    match /asignaciones_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /asistencias_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    // ── Actividades de Ventas ────────────────────────────────────────────────
    match /actividades_ventas/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
    }

    // ── Formularios universitarios (Solicitud e Informe de Actividad) ─────────
    match /solicitudes_actividad/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    match /informes_actividad/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // ── Reuniones (Secretaría) ────────────────────────────────────────────────
    match /reuniones/{id} {
      allow read: if isStaff();
      allow create, update, delete: if hasRol(['ceo', 'secretario']);
    }

    // ── Denegar todo lo no definido explícitamente ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
