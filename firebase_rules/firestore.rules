rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userRol() {
      return userExists() ? userDoc().data.rol : '';
    }

    function hasRol(roles) {
      return userExists() && userRol() in roles;
    }

    // Lista cerrada: un rol ausente, nulo o escrito incorrectamente nunca
    // debe heredar permisos de staff por accidente.
    function rolesStaff() {
      return [
        'ceo', 'junta_principal', 'junta', 'coordinador',
        'finanzas', 'logistica', 'ventas', 'secretario', 'actividades',
        'patrocinios', 'investigacion', 'voluntariado', 'giras',
        'comunicaciones', 'staff_contecs', 'miembro'
      ];
    }

    function isStaff() {
      return hasRol(rolesStaff());
    }

    // ── Permisos individuales ────────────────────────────────────────────────
    // El rol es la base; el CEO puede darle o quitarle permisos sueltos a una
    // persona desde Usuarios: usuarios/{uid}.permisosExtra =
    //   { permiso: { modo: 'otorgar' | 'quitar', vence: timestamp | null } }
    // Misma regla que tienePermiso() en js/core/permisos.js y usuarioPuede()
    // en functions/permisos.js. Solo cuentan para roles internos que no sean
    // CEO: "sin_rol" desactiva la cuenta aunque conserve ajustes.
    //
    // Firestore deja de evaluar (y NIEGA) al llegar a 1000 expresiones por
    // petición. Por eso el rol y los ajustes se leen una sola vez en sesion()
    // y se pasan a los helpers "...De(s, ...)"; las reglas que revisan varios
    // permisos seguidos usan esos directamente.
    function sesion() {
      let rol = userRol();
      return {
        'rol': rol,
        'ajustable': rol in rolesStaff() && rol != 'ceo',
        'extra': rol != '' ? userDoc().data.get('permisosExtra', {}) : {}
      };
    }

    // Permisos por rol (Usuarios → "Permisos por rol"), en
    // config/permisos_roles = { roles: { rol: { permiso: { modo } } } }.
    function ajusteDelRolDe(rol, permiso) {
      return exists(/databases/$(database)/documents/config/permisos_roles)
        ? get(/databases/$(database)/documents/config/permisos_roles).data
            .get('roles', {}).get(rol, {}).get(permiso, {}).get('modo', '')
        : '';
    }

    // 'otorgar', 'quitar' o '' (sin ajuste). El ajuste propio manda sobre el
    // de su rol; un "otorgar" con vence deja de valer al pasar esa fecha (y
    // entonces cuenta el del rol). Solo para quien es s.ajustable.
    function modoDe(s, permiso) {
      let propio = s.extra.get(permiso, {});
      let modo = propio.get('modo', '');
      let vence = propio.get('vence', null);
      return modo == 'quitar' ? 'quitar'
        : (modo == 'otorgar' && (vence == null || request.time < vence)) ? 'otorgar'
        : ajusteDelRolDe(s.rol, permiso);
    }

    function otorgadoDe(s, permiso) {
      return s.ajustable && modoDe(s, permiso) == 'otorgar';
    }

    // Para reglas que corresponden a UN permiso de la app: los roles de
    // siempre, menos a quien se lo quitaron, más a quien se lo dieron.
    // Donde una colección la usan varios módulos (ventas, compras...) solo se
    // suman los otorgados: quitar un permiso esconde el módulo en el panel,
    // pero el rol sigue leyendo lo que necesitan sus otros módulos.
    function permiteDe(s, permiso, roles) {
      let modo = s.ajustable ? modoDe(s, permiso) : '';
      return (s.rol in roles && modo != 'quitar') || modo == 'otorgar';
    }

    function otorgado(permiso) {
      return otorgadoDe(sesion(), permiso);
    }

    function permite(permiso, roles) {
      return permiteDe(sesion(), permiso, roles);
    }

    // Sub-permiso (pestaña o acción de un módulo, SUBPERMISOS en
    // js/core/permisos.js): su propio ajuste manda; sin ajuste sigue al
    // permiso del módulo.
    function permiteSub(sub, modulo, roles) {
      let s = sesion();
      let modo = s.ajustable ? modoDe(s, sub) : '';
      return modo != 'quitar' && (modo == 'otorgar' || permiteDe(s, modulo, roles));
    }

    // Debe reflejar exactamente "ver_participantes" en js/core/permisos.js.
    // Coordinador SÍ puede ver la lista de participantes; actividades y
    // comunicaciones NO (no tienen ese permiso en el modelo de la app).
    // Gestión de Evento, Lectura QR, Estadísticas y POSPER también leen la
    // lista: a quien se le otorgan esos módulos se le abre la lectura.
    function canVerParticipantesDe(s) {
      return permiteDe(s, 'ver_participantes', [
        'ceo', 'junta_principal', 'junta', 'coordinador', 'staff_contecs'
      ])
        || otorgadoDe(s, 'gestionar_inscripciones')
        || otorgadoDe(s, 'lectura_qr')
        || otorgadoDe(s, 'gestionar_credenciales')
        || otorgadoDe(s, 'ver_estadisticas_congreso')
        || otorgadoDe(s, 'acceso_posper');
    }

    function canVerParticipantes() {
      return canVerParticipantesDe(sesion());
    }

    // ── Datos personales: solo las pantallas que los usan ────────────────────
    // Antes bastaba isStaff(): cualquier rol del staff (hasta Miembro General)
    // podía bajar cédulas, teléfonos y correos.
    function puedeVerEstadisticasDe(s) {
      return permiteDe(s, 'ver_estadisticas_congreso', ['ceo', 'junta_principal', 'finanzas', 'staff_contecs']);
    }

    // Voluntarios: módulo Voluntarios (y su widget del dashboard), Lectura QR
    // de voluntarios, Credenciales y Estadísticas.
    function puedeVerVoluntarios() {
      let s = sesion();
      return permiteDe(s, 'gestionar_voluntarios', ['ceo', 'junta_principal', 'junta', 'voluntariado'])
        || otorgadoDe(s, 'voluntarios_lectura_qr')
        || permiteDe(s, 'gestionar_credenciales', ['ceo'])
        || puedeVerEstadisticasDe(s);
    }

    // Inscripciones a actividades: Gestión de Evento, Lectura QR y Estadísticas.
    function puedeVerInscripcionesDe(s) {
      return permiteDe(s, 'gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs'])
        || otorgadoDe(s, 'lectura_qr')
        || puedeVerEstadisticasDe(s);
    }

    function puedeVerInscripciones() {
      return puedeVerInscripcionesDe(sesion());
    }

    // Asistencias del congreso (llevan cédula y correo): además quien ve
    // participantes y quien libera asientos en el Mapa. El resto del Mapa usa
    // los conteos de mapaPublico, sin datos personales.
    // Debe reflejar puedeVerPresentes() en js/modulos/mapa.js.
    function puedeVerAsistenciasCongreso() {
      let s = sesion();
      return puedeVerInscripcionesDe(s)
        || canVerParticipantesDe(s)
        || permiteDe(s, 'liberar_asiento', ['ceo', 'staff_contecs']);
    }

    // Patrocinador POSPER ("acceso_posper" en js/core/permisos.js). No es
    // staff: solo lee lo que necesitan posper.html y los randomizer
    // (participantes, eventos y checkpoints). Todo lo que escribe pasa por
    // ejecutarOperacionQr.
    function isPosper() {
      return hasRol(['posper']);
    }

    // Debe reflejar exactamente "aprobar_pagos" en js/core/permisos.js.
    // Ver la lista no implica poder aprobar/rechazar un pago — coordinador
    // queda fuera de este segundo permiso a propósito.
    function canAprobarPagosParticipantes() {
      return permite('aprobar_pagos', [
        'ceo', 'junta_principal', 'junta', 'finanzas', 'secretario', 'staff_contecs'
      ]);
    }

    // Módulos de Finanzas/Logística que leen ventas, compras, mermas y
    // movimientos de inventario (bitácora, reportes, inventario, compras).
    function otorgadoLecturaFinanciera() {
      return otorgado('ver_bitacora') || otorgado('ver_reportes')
        || otorgado('ver_inventario') || otorgado('registrar_compras')
        || otorgado('ver_fondos');
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'finanzas'])
        || otorgado('gestionar_usuarios')
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['nombre', 'email', 'foto', 'rol', 'creadoEn'])
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'foto', 'rol', 'creadoEn'])
        && request.resource.data.rol == 'sin_rol'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && request.resource.data.foto is string
        && request.resource.data.foto.size() <= 2048;
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'foto', 'actualizadoEn'])
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.email == resource.data.email
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 120
          && request.resource.data.foto is string
          && request.resource.data.foto.size() <= 2048)
        // El CEO cambia los demás campos. El ROL y los permisos individuales
        // no se cambian desde el navegador, ni siquiera el CEO: pasan por las
        // Cloud Functions cambiarRolUsuario y guardarPermisosUsuario, que
        // piden la contraseña.
        || (hasRol(['ceo'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'rol', 'rolCambiadoPor', 'rolCambiadoEn',
            'permisosExtra', 'permisosActualizadosPor', 'permisosActualizadosEn'
          ]))
      );
    }

    // ── Participantes ─────────────────────────────────────────────────────────
    // El alta y el acceso público se realizan exclusivamente mediante Cloud
    // Functions (Admin SDK). Nunca se expone la colección completa al browser.
    match /participantes/{docId} {
      allow read: if canVerParticipantes() || isPosper();
      allow create: if false;
      allow update: if canAprobarPagosParticipantes()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'asistencias', 'totalAsistencias', 'rfid'
        ]);
      allow delete: if permite('eliminar_participantes', ['ceo', 'junta_principal']);
    }

    // Historial de impresión del módulo Credenciales: un documento por persona
    // (id = participante_<id>, voluntario_<docId>, expositor_<id>...).
    match /credenciales_impresas/{id} {
      allow read: if permite('gestionar_credenciales', ['ceo']);
      allow create, update: if permite('gestionar_credenciales', ['ceo'])
        && id.matches('^[a-z]+_[A-Za-z0-9_-]{1,120}$')
        && request.resource.data.keys().hasOnly([
          'tipo', 'nombre', 'veces', 'primeraEn', 'ultimaEn', 'ultimaPor'
        ])
        && request.resource.data.tipo is string
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 200
        && request.resource.data.veces is int
        && request.resource.data.veces >= 1
        && request.resource.data.ultimaPor == request.auth.uid;
      allow delete: if permite('gestionar_credenciales', ['ceo']);
    }

    // Expositores agregados a mano o importados en el módulo Credenciales
    // (los que no se inscribieron como participantes).
    match /expositores/{id} {
      allow read: if permite('gestionar_credenciales', ['ceo']);
      allow create, update: if permite('gestionar_credenciales', ['ceo'])
        && request.resource.data.keys().hasOnly([
          'nombre', 'apellido', 'cedula', 'correo', 'institucion', 'tema',
          'creadoPor', 'creadoEn', 'actualizadoEn', 'lote'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.get('apellido', '') is string
        && request.resource.data.get('apellido', '').size() <= 100
        && request.resource.data.get('institucion', '') is string
        && request.resource.data.get('institucion', '').size() <= 150
        && request.resource.data.get('tema', '') is string
        && request.resource.data.get('tema', '').size() <= 200;
      allow delete: if permite('gestionar_credenciales', ['ceo']);
    }

    // RFID anclado desde POSPER — solo Admin SDK (ejecutarOperacionQr)
    match /rfid_participantes/{id} {
      allow read, write: if false;
    }

    // Contador secuencial — solo Admin SDK (Cloud Functions)
    match /contadores/{id} {
      allow read, write: if false;
    }

    // Índices internos y límites antiabuso: únicamente Admin SDK.
    match /identificadores_participantes/{id} {
      allow read, write: if false;
    }

    match /limites_registro/{id} {
      allow read, write: if false;
    }

    // Cambio de rol con contraseña (cambiarRolUsuario): intentos fallidos
    // por usuario y registro de cada cambio. Solo Admin SDK.
    match /intentos_cambio_rol/{id} {
      allow read, write: if false;
    }
    match /cambios_rol/{id} {
      allow read, write: if false;
    }
    // Permisos por rol: el staff los lee para saber qué puede hacer; solo los
    // escribe guardarPermisosRol (con la contraseña de Usuarios).
    match /config/{docId} {
      allow read: if docId == 'permisos_roles' && isStaff();
      allow write: if false;
    }
    // Bitácora de cambios de permisos (individuales y por rol). Solo Admin SDK.
    match /cambios_permisos/{id} {
      allow read, write: if false;
    }

    // Cédula única del registro público de voluntarios (registrarVoluntario).
    match /identificadores_voluntarios/{id} {
      allow read, write: if false;
    }

    // Caché del mapa público (mapaPublico): se entrega por la función, nunca
    // directo al navegador.
    match /publico/{id} {
      allow read, write: if false;
    }

    // ── Inventario y catálogo ────────────────────────────────────────────────
    match /productos/{id} {
      allow read: if isStaff();
      allow create: if permiteSub('catalogo_productos', 'editar_catalogo', ['ceo', 'junta_principal', 'junta', 'ventas', 'logistica'])
        && request.resource.data.keys().hasOnly([
          'nombre', 'precioVenta', 'alertaMinima', 'iconoId', 'categoriaId',
          'stock', 'activo', 'creadoEn'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 150
        && request.resource.data.precioVenta is number
        && request.resource.data.precioVenta >= 0
        && request.resource.data.alertaMinima is number
        && request.resource.data.alertaMinima >= 0
        && request.resource.data.stock == 0
        && request.resource.data.activo == true;
      allow update: if permiteSub('catalogo_productos', 'editar_catalogo', ['ceo', 'junta_principal', 'junta', 'ventas', 'logistica'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'iconoId', 'precioVenta', 'alertaMinima', 'activo'
        ]);
      allow delete: if false;
    }

    match /categorias/{id} {
      allow read: if isStaff();
      allow write: if permiteSub('catalogo_categorias', 'editar_catalogo', ['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
    }

    // ── Operaciones financieras ──────────────────────────────────────────────
    match /ventas/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
        || otorgadoLecturaFinanciera();
      // Las ventas se crean exclusivamente desde Cloud Functions, que valida
      // rol, identidad, productos, precios y movimientos relacionados.
      allow create: if false;
      allow update, delete: if false;
    }

    match /compras/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
        || otorgadoLecturaFinanciera();
      allow create: if false;
      // Tras registrar la compra, el flujo sube la factura a Storage y luego
      // actualiza solo su estado (factura/facturaEstado/facturaError); quien
      // pudo crear la compra debe poder cerrar ese mismo paso.
      allow update: if (hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
          || otorgado('registrar_compras'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'factura', 'facturaEstado', 'facturaError', 'actualizadoEn'
        ])
        && request.resource.data.facturaEstado == 'subida'
        && request.resource.data.factura is map
        && request.resource.data.factura.uploadedBy == request.auth.uid;
      allow delete: if false;
    }

    match /mermas/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
        || otorgadoLecturaFinanciera();
      allow create: if false;
      allow update, delete: if false;
    }

    match /fondos/{id} {
      // Ver y editar el fondo libremente: solo gestión financiera.
      allow read: if permite('ver_fondos', ['ceo', 'junta_principal', 'junta', 'finanzas']);
      allow create, delete: if false;
      // Los movimientos pasan por Cloud Functions; ni siquiera Finanzas puede
      // reescribir el balance directamente desde DevTools.
      allow update: if false;
    }

    match /fondos_entrada/{id} {
      allow read: if permite('ver_fondos', ['ceo', 'junta_principal', 'junta', 'finanzas']);
      allow create: if false;
      allow update, delete: if false;
    }

    match /movimientos_inventario/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
        || otorgadoLecturaFinanciera();
      allow create: if false;
      allow update, delete: if false;
    }

    // ── Eventos e inscripciones internas ─────────────────────────────────────
    match /eventos/{id} {
      allow read: if isStaff() || isPosper();
      allow write: if permiteSub('evento_editar', 'gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs']);
    }

    match /inscripciones/{id} {
      allow read: if puedeVerInscripciones();
      allow create, delete: if permite('gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs']);
      allow update: if permite('gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'asistencias', 'totalAsistencias'
        ]);
    }

    // Checkpoints detallados del programa (colección separada)
    match /checkpoints/{id} {
      allow read: if isStaff() || isPosper();
      allow write: if permiteSub('evento_editar', 'gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs']);
    }

    // Salones del Mapa del evento: un doc por espacio del plano (id
    // "piso-número", js/data/planos-edificio3.js). Los gestiona quien
    // gestiona checkpoints; los ve todo el staff (el patrocinador no).
    match /salones/{espacioId} {
      allow read: if isStaff();
      allow create, update: if permiteSub('evento_salones', 'gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs'])
        && espacioId.matches('^[0-9]{1,2}-[0-9]{1,4}$')
        && request.resource.data.keys().hasOnly([
          'espacioId', 'piso', 'nombre', 'rotulo', 'capacidad', 'actualizadoEn', 'actualizadoPor'
        ])
        && request.resource.data.espacioId == espacioId
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.rotulo is string
        && request.resource.data.rotulo.size() <= 7
        && request.resource.data.capacidad is int
        && request.resource.data.capacidad >= 1
        && request.resource.data.capacidad <= 100000;
      allow delete: if permiteSub('evento_salones', 'gestionar_inscripciones', ['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades', 'staff_contecs']);
    }

    // Inscripciones in-situ a talleres por QR (decrementa cupos)
    match /inscripciones_checkpoint/{id} {
      allow read: if puedeVerInscripciones();
      allow create, update, delete: if false;
    }

    // Registro auditable y centralizado de cada asistencia confirmada por QR.
    match /asistencias_congreso/{id} {
      allow read: if puedeVerAsistenciasCongreso();
      allow create, update, delete: if false;
    }

    // ── Voluntarios ──────────────────────────────────────────────────────────
    // El rol 'actividades' (Lider de Actividades) es el dueno funcional del
    // modulo panel/modulos/voluntariado/actividades.html: crea, edita, activa,
    // desactiva y elimina actividades, y administra sus turnos.
    match /actividades_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado', 'actividades'])
        || otorgado('gestionar_actividades') || otorgado('gestionar_voluntarios');
    }

    match /giras_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado', 'giras'])
        || otorgado('gestionar_giras');
    }

    // Check-in/check-out de gira (doble checkpoint) — escritura únicamente
    // vía Cloud Function marcarCheckpointGira (Admin SDK). No bloquea por
    // pago.estado a propósito: ver PLAN_GIRAS_Y_CSV.md, punto 5.
    match /asistencias_giras/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /asignaciones_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if permite('gestionar_voluntarios', ['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /voluntarios/{id} {
      allow read: if puedeVerVoluntarios();
      allow create: if permite('gestionar_voluntarios', ['ceo', 'junta_principal', 'junta', 'voluntariado'])
        && request.resource.data.totalHoras == 0;
      // Cambiar el grupo (voluntario ↔ comité organizador) pide además
      // "voluntarios_cambiar_grupo" (js/core/permisos.js): por ahora solo CEO.
      allow update: if permite('gestionar_voluntarios', ['ceo', 'junta_principal', 'junta', 'voluntariado'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalHoras'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['grupo'])
          || permite('voluntarios_cambiar_grupo', ['ceo']));
      allow delete: if permite('gestionar_voluntarios', ['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /asistencias_voluntarios/{id} {
      allow read: if puedeVerVoluntarios();
      allow write: if false;
    }

    // ── Actividades de Ventas ────────────────────────────────────────────────
    match /actividades_ventas/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica'])
        || otorgado('gestionar_ventas');
    }

    // ── Formularios universitarios (Solicitud e Informe de Actividad) ─────────
    match /solicitudes_actividad/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades'])
        || otorgado('gestionar_actividades');
    }

    match /informes_actividad/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades'])
        || otorgado('gestionar_actividades');
    }

    // ── Reuniones (Secretaría) ────────────────────────────────────────────────
    match /reuniones/{id} {
      allow read: if isStaff();
      allow create, update, delete: if permite('gestionar_secretaria', ['ceo', 'secretario']);
    }

    // ── Denegar todo lo no definido explícitamente ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
