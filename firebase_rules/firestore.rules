rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userRol() {
      return userExists() ? userDoc().data.rol : '';
    }

    function hasRol(roles) {
      return userExists() && userRol() in roles;
    }

    function isStaff() {
      return userExists() && userRol() != 'sin_rol';
    }

    function canGestionarParticipantes() {
      return hasRol([
        'ceo', 'junta_principal', 'junta', 'coordinador',
        'actividades', 'finanzas', 'secretario', 'comunicaciones'
      ]);
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'finanzas'])
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rol == 'sin_rol';
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']))
        || hasRol(['ceo', 'junta_principal'])
      );
    }

    // ── Participantes ─────────────────────────────────────────────────────────
    // Escritura pública: el formulario de registro escribe directamente desde el browser.
    // ── Participantes ────────────────────────────────────────────────────────
    match /participantes/{docId} {
      // Lectura pública: perfil.html consulta por codigo+token sin auth
      allow read: if true;
      // Escritura pública: registro desde el browser sin auth
      allow create: if true;
      allow update: if canGestionarParticipantes();
      allow delete: if hasRol(["ceo","junta_principal"]);
    }

    // Contador secuencial — solo Admin SDK (Cloud Functions)
    match /contadores/{id} {
      allow read, write: if false;
    }

    // ── Inventario y catálogo ────────────────────────────────────────────────
    match /productos/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
    }

    match /categorias/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
    }

    // ── Operaciones financieras ──────────────────────────────────────────────
    match /ventas/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /compras/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /mermas/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /fondos/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas']);
      allow write: if hasRol(['ceo', 'junta_principal', 'finanzas']);
    }

    match /fondos_entrada/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas']);
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    match /movimientos_inventario/{id} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica']);
      allow create: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
      allow update, delete: if hasRol(['ceo', 'junta_principal']);
    }

    // ── Eventos e inscripciones internas ─────────────────────────────────────
    match /eventos/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    match /inscripciones/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // Checkpoints detallados del programa (colección separada)
    match /checkpoints/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // Inscripciones in-situ a talleres por QR (decrementa cupos)
    match /inscripciones_checkpoint/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if hasRol(['ceo', 'junta_principal', 'junta', 'coordinador', 'actividades']);
    }

    // ── Voluntarios ──────────────────────────────────────────────────────────
    match /actividades_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /giras_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado', 'giras']);
    }

    match /asignaciones_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    match /asistencias_voluntarios/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'voluntariado']);
    }

    // ── Actividades de Ventas ────────────────────────────────────────────────
    match /actividades_ventas/{id} {
      allow read: if isStaff();
      allow write: if hasRol(['ceo', 'junta_principal', 'junta', 'ventas', 'logistica']);
    }

    // ── Denegar todo lo no definido explícitamente ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
