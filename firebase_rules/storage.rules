rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in [
          'ceo', 'junta_principal', 'junta', 'coordinador',
          'finanzas', 'logistica', 'ventas', 'secretario', 'actividades',
          'patrocinios', 'investigacion', 'voluntariado', 'giras',
          'comunicaciones', 'staff_contecs', 'miembro'
        ];
    }

    function canGestionarParticipantes() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in [
          'ceo', 'junta_principal', 'junta', 'coordinador',
          'actividades', 'finanzas', 'secretario', 'comunicaciones', 'staff_contecs'
        ];
    }

    // CVE-C03: comprobantes de pago — escritura solo vía Admin SDK (Cloud Function)
    match /comprobantes/{filename} {
      allow read: if canGestionarParticipantes();
      allow write: if false;
    }

    // Facturas de compras — mismos roles que pueden consultar compras.
    match /compras/{compraId}/facturas/{filename} {
      allow read: if signedIn()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in [
          'ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'
        ];
      allow write: if signedIn()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in [
          'ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'
        ]
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
