rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function usuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasRol(roles) {
      return signedIn() && usuario().rol in roles;
    }

    function isStaff() {
      return hasRol([
          'ceo', 'junta_principal', 'junta', 'coordinador',
          'finanzas', 'logistica', 'ventas', 'secretario', 'actividades',
          'patrocinios', 'investigacion', 'voluntariado', 'giras',
          'comunicaciones', 'staff_contecs', 'miembro'
        ]);
    }

    // Permisos individuales: misma regla que otorgado()/quitado()/permite()
    // en firestore.rules (ver allí).
    function ajuste(permiso) {
      return usuario().get('permisosExtra', {}).get(permiso, {});
    }

    function admiteAjustes() {
      return isStaff() && usuario().rol != 'ceo';
    }

    function otorgado(permiso) {
      return admiteAjustes()
        && ajuste(permiso).get('modo', '') == 'otorgar'
        && (ajuste(permiso).get('vence', null) == null
          || request.time < ajuste(permiso).get('vence', null));
    }

    function quitado(permiso) {
      return admiteAjustes() && ajuste(permiso).get('modo', '') == 'quitar';
    }

    function permite(permiso, roles) {
      return (hasRol(roles) && !quitado(permiso)) || otorgado(permiso);
    }

    // Ver comprobantes de pago es parte del flujo de aprobación, no de "ver
    // participantes" — coordinador puede ver la lista de participantes
    // (firestore.rules) pero no las fotos de comprobantes de pago.
    // Debe reflejar "aprobar_pagos" en js/core/permisos.js.
    function canAprobarPagosParticipantes() {
      return permite('aprobar_pagos', [
          'ceo', 'junta_principal', 'junta', 'finanzas', 'secretario', 'staff_contecs'
        ]);
    }

    // CVE-C03: comprobantes de pago — escritura solo vía Admin SDK (Cloud Function)
    match /comprobantes/{filename} {
      allow read: if canAprobarPagosParticipantes();
      allow write: if false;
    }

    // Facturas de compras — mismos roles que pueden consultar compras.
    match /compras/{compraId}/facturas/{filename} {
      allow read: if hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
        || otorgado('registrar_compras') || otorgado('ver_bitacora');
      allow write: if (hasRol(['ceo', 'junta_principal', 'junta', 'finanzas', 'ventas', 'logistica'])
          || otorgado('registrar_compras'))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
