rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol != 'sin_rol';
    }

    function canGestionarParticipantes() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in [
          'ceo', 'junta_principal', 'junta', 'coordinador',
          'actividades', 'finanzas', 'secretario', 'comunicaciones'
        ];
    }

    // CVE-C03: comprobantes de pago — escritura solo vía Admin SDK (Cloud Function)
    match /comprobantes/{filename} {
      allow read: if canGestionarParticipantes();
      allow write: if false;
    }

    // Facturas de compras — staff autenticado
    match /compras/{compraId}/facturas/{filename} {
      allow read: if isStaff();
      allow write: if signedIn() && isStaff()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
