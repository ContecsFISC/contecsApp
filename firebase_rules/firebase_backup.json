{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "..",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "mateo_docs",
        "docs",
        "css",
        "js",
        "modulos",
        "icons",
        ".vscode",
        ".cursor",
        "firebase_rules",
        "*.html",
        "auth.js",
        "ventas2.js",
        "CLAUDE.md"
      ]
    }
  ]
}
