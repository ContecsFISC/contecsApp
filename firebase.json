{
  "firestore": {
    "rules": "firebase_rules/firestore.rules",
    "indexes": "firebase_rules/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase_rules/storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "mateo_docs/**",
      "firebase_rules/**",
      "docs/**",
      "graph-out/**",
      ".github/**",
      ".vscode/**",
      "AlphaToolGraph.py",
      "AGENTS.md",
      "README*",
      "package*.json",
      "*-debug.log",
      "*.zip",
      "*.exe"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=()"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/ms/auth",
        "destination": "/public/ms/auth.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix functions run lint"
      ]
    }
  ]
}
